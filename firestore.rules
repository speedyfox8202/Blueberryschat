
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function chatMember(chatId) {
      return signedIn() &&
        request.auth.uid in
        get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }

    match /users/{uid} {
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 24;

      allow read: if signedIn();

      allow update: if isSelf(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.username == resource.data.username
        && request.resource.data.usernameLower == resource.data.usernameLower;

      allow delete: if false;
    }

    match /chats/{chatId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() >= 2
        && request.resource.data.members.size() <= 20
        && request.resource.data.type in ['direct', 'group'];

      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members.size() <= 20
        && (
          (
            request.resource.data.members == resource.data.members
            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['updatedAt', 'lastMessage', 'memberNames'])
          )
          ||
          (
            resource.data.type == 'group'
            && resource.data.ownerId == request.auth.uid
            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['members', 'memberNames', 'updatedAt'])
          )
          ||
          (
            resource.data.type == 'group'
            && request.auth.uid in resource.data.members
            && !(request.auth.uid in request.resource.data.members)
            && request.resource.data.members.size()
              == resource.data.members.size() - 1
            && resource.data.members.hasAll(request.resource.data.members)
            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['members'])
          )
        );

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if chatMember(chatId);

        allow create: if chatMember(chatId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000;

        allow update, delete: if false;
      }
    }
  }
}
